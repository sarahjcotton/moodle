    @template core_admin/oauth2/server/client_secrets_limit_reached_alert
    @summary Alert shown when the client secrets limit has been reached.

    Context variables required for this template:
    * maxsecretsnumber - The maximum number of active secrets allowed for the client.
    * isclientactive - Whether the client is active.

    Example context (json):
    {
        "maxsecretsnumber": 2,
        "isclientactive": true
    }
}}
<div id="client-secrets-limit-reached-alert" class="alert alert-info d-flex align-items-start">
    <i class="fa fa-circle-info me-2 mt-1" aria-hidden="true"></i>
    <div>
        <span class="alert-text d-flex fw-bold">
            {{#str}} oauth2server_clientsecretslimitreached, admin, {{maxsecretsnumber}} {{/str}}
        </span>
        <span>
            {{#isclientactive}}
                {{#str}} oauth2server_revokeactivesecrettoaddnew, admin {{/str}}
            {{/isclientactive}}
            {{^isclientactive}}
                {{#str}} oauth2server_revokeinactivesecrettoaddnew, admin {{/str}}
            {{/isclientactive}}
        </span>
    </div>
</div>
