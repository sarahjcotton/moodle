    @template core_admin/oauth2/server/manage_client_secrets
    @summary Renders the content for the client secret management page.

    Context variables required for this template:
    * title - The client's name.
    * clientidentifier - The public client identifier.
    * isclientactive - Whether the client is active.
    * backurl - The URL to return to the clients list.
    * clientsecretstable - The rendered table of client secrets.
    * cancreatesecret - Whether a new client secret can be created.
    * id - The ID of the client.
    * maxsecretsnumber - The maximum number of client secrets allowed.

    Example context (json):
    {
        "title": "Community mobile app",
        "clientidentifier": "4c7a2e9f1d6b0835",
        "isclientactive": true,
        "backurl": "/admin/oauth2/clients.php",
        "clientsecretstable": "<table>...</table>",
        "cancreatesecret": true,
        "id": 1,
        "maxsecretsnumber": 2
    }
}}
<div class="oauth2-client-header mb-4">
    {{>core_admin/oauth2/server/client_heading}}
    <h3 class="fs-4 fw-bold mt-4">{{#str}} oauth2server_clientsecrets, admin {{/str}}</h3>
    {{^isclientactive}}
        <div class="alert alert-warning d-flex align-items-start mt-4">
            <i class="fa fa-exclamation-triangle me-2 mt-1" aria-hidden="true"></i>
            <div>
                <span class="alert-text d-flex fw-bold">
                    {{#str}} oauth2server_clientcurrentlydisabled, admin {{/str}}
                </span>
                <span>
                    {{#str}} oauth2server_secretsinactivewarning, admin {{/str}}
                </span>
            </div>
        </div>
    {{/isclientactive}}
    {{{clientsecretstable}}}
    <button class="btn btn-primary mt-4 {{^cancreatesecret}} d-none {{/cancreatesecret}}"
            data-clientid="{{id}}"
            data-clientidentifier="{{clientidentifier}}"
            data-action="generate-secret"
            {{^cancreatesecret}}disabled{{/cancreatesecret}}
    >
        {{#str}} oauth2server_clientsecretgenerate, admin {{/str}}
    </button>
    <div id="client-secrets-alert-container" class="mt-4" role="status">
        {{^cancreatesecret}}
            {{>core_admin/oauth2/server/client_secrets_limit_reached_alert}}
        {{/cancreatesecret}}
    </div>
</div>
